DJANGO_SETTINGS_MODULE=backend.settings.development

SECRET_KEY=change-me

DB_NAME=mon_armoire
DB_USER=mon_armoire_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

ALLOWED_HOSTS=monarmoire.store,www.monarmoire.store,backend.monarmoire.store
CORS_ALLOWED_ORIGINS=https://monarmoire.store,https://www.monarmoire.store

# E-mail LWS : sur mutualisé, le serveur Exim local (localhost:25, sans SSL) est la configuration qui a fonctionné sur
# EthniSpirit ; EMAIL_HOST_USER/PASSWORD peuvent rester vides en local. Alternative : mail.monarmoire.store, 465, SSL.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_SSL=False
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_FILE=vapid_private.pem
VAPID_CONTACT_EMAIL=contact@monarmoire.store

FRONTEND_URL=http://localhost:5173

GENIUSPAY_PUBLIC_KEY=
GENIUSPAY_SECRET_KEY=
GENIUSPAY_WEBHOOK_SECRET=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# ── Production (LWS) ──────────────────────────────────────────────────────────
# SECRET_KEY : aléatoire, 50 caractères minimum (le démarrage est refusé sinon)
ADMIN_URL=admin/
CSRF_TRUSTED_ORIGINS=https://monarmoire.store,https://www.monarmoire.store,https://backend.monarmoire.store
# Dossier media DANS le dossier public du sous-domaine backend (servi directement par Apache)
# Médias : dossier public du SITE principal, servi par Apache (même origine que le frontend)
MEDIA_ROOT=/home/VOTRE_LOGIN/public_html/media
MEDIA_URL=https://monarmoire.store/media/
CACHE_DIR=
LOG_DIR=
DB_CONN_MAX_AGE=60
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_PROXY_SSL_HEADER_ENABLED=False
