# Modèle du fichier .env de PRODUCTION (backend). À copier sur le serveur sous le nom :
#   /home/VOTRE_LOGIN/mon_armoire/backend/.env        puis : chmod 600 .env
# Ne jamais mettre ce fichier dans un dépôt ni dans public_html.

DJANGO_SETTINGS_MODULE=backend.settings.production

# Clé secrète : 50 caractères aléatoires minimum (le serveur refuse de démarrer sinon). Générer avec :
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k()+k())"
SECRET_KEY=

# Base PostgreSQL LWS (cPanel > Bases de données PostgreSQL)
DB_NAME=VOTRE_LOGIN_monarmoire
DB_USER=VOTRE_LOGIN_maruser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Adresses
FRONTEND_URL=https://monarmoire.store
ALLOWED_HOSTS=monarmoire.store,www.monarmoire.store,backend.monarmoire.store
CORS_ALLOWED_ORIGINS=https://monarmoire.store,https://www.monarmoire.store
CSRF_TRUSTED_ORIGINS=https://monarmoire.store,https://www.monarmoire.store,https://backend.monarmoire.store

# Photos : dossier public du SITE (servi directement par Apache) et son adresse publique
MEDIA_ROOT=/home/VOTRE_LOGIN/public_html/media
MEDIA_URL=https://monarmoire.store/media/
# Cache et journaux : HORS de public_html
CACHE_DIR=/home/VOTRE_LOGIN/mon_armoire/cache
LOG_DIR=/home/VOTRE_LOGIN/mon_armoire/logs

# E-mail : serveur local LWS (configuration qui fonctionne sur EthniSpirit)
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_USE_SSL=False
EMAIL_USE_TLS=False
EMAIL_HOST_USER=contact@monarmoire.store
EMAIL_HOST_PASSWORD=

# Notifications push (verset du jour) : mêmes clés qu'en local ; copier vapid_private.pem à côté de manage.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_FILE=vapid_private.pem
VAPID_CONTACT_EMAIL=contact@monarmoire.store

# Paiements : clés LIVE (pas de test). Webhooks à déclarer chez les fournisseurs :
#   https://backend.monarmoire.store/api/payments/geniuspay/webhook/
#   https://backend.monarmoire.store/api/payments/paystack/webhook/
GENIUSPAY_PUBLIC_KEY=
GENIUSPAY_SECRET_KEY=
GENIUSPAY_WEBHOOK_SECRET=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# Sécurité
ADMIN_URL=gestion-xxxxxx/
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Ne passer à True que si le site boucle en redirection HTTPS après la mise en ligne
SECURE_PROXY_SSL_HEADER_ENABLED=False
DB_CONN_MAX_AGE=60
