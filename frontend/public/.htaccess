# Site vitrine React (monarmoire.com) — copié tel quel dans dist/ par `npm run build`
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS obligatoire
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Application monopage : toute route inconnue renvoie index.html (hors fichiers et dossiers réels)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /index.html [L]
  # Marque les fichiers hachés de Vite (assets/) : cache 1 an ; les médias (un nouvel upload = un nouveau nom) : 30 jours
  RewriteRule ^assets/ - [E=HASHED_ASSET:1]
  RewriteRule ^media/  - [E=MEDIA_FILE:1]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  # connect-src/img-src : adapter le domaine de l'API si différent de backend.monarmoire.com
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: ; connect-src 'self' https://backend.monarmoire.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

  # Fichiers hachés par Vite (assets/) : cache longue durée. Autres images : 1 jour.
  # index.html, service worker et manifeste : toujours revalidés.
  Header set Cache-Control "public, max-age=31536000, immutable" env=HASHED_ASSET
  Header set Cache-Control "public, max-age=2592000" env=MEDIA_FILE
  <FilesMatch "\.(png|jpe?g|webp|svg|ico)$">
    Header setifempty Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "(index\.html|sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
